# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/
.env.local.bak.*

# generated by scripts/sync-maplibre-worker.mjs (predev/prebuild)
public/maplibre/

# parse_gpx.py --skip-existing bookkeeping (local cache, not source of truth)
src/data/courses/*.source.sha256

# bulk import working files: HTTP cache, raw crawl output, parse reports.
# decisions.json IS committed — it is the record of which permanent course
# slugs a human approved, and losing it means re-reviewing everything.
data/import/cache/
data/import/raw/
data/import/reports/
